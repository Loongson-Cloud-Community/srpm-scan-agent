#!/usr/bin/python3
"""SRPM event fields; transport and recovery use the shared client."""

import argparse
from datetime import datetime, timezone
import json
import os
import sys

from scan_agent_events.delivery import deliver_event


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("event", choices=("started", "completed", "failed", "replay"))
    parser.add_argument("--srpm-name")
    parser.add_argument("--event-time")
    parser.add_argument("--csmock-exit-code", type=int)
    args = parser.parse_args()
    if args.event != "replay":
        for name in ("srpm_name",):
            if getattr(args, name) is None:
                parser.error(f"--{name.replace('_', '-')} is required")
    return args


def event_body(args):
    event_time = args.event_time or datetime.now(timezone.utc).isoformat()
    payload = {
        "event": args.event,
        "jenkins_build_number": int(os.environ["BUILD_NUMBER"]),
        "jenkins_job_full_name": os.environ["JOB_NAME"],
        "srpm_name": args.srpm_name,
    }
    payload["created_at" if args.event == "started" else "finished_at"] = event_time
    if args.csmock_exit_code is not None:
        payload["csmock_exit_code"] = args.csmock_exit_code

    return json.dumps(payload).encode("utf-8")


def main():
    args = parse_args()
    if args.event == "replay":
        return deliver_event("srpm")
    return deliver_event("srpm", lambda: event_body(args))


if __name__ == "__main__":
    sys.exit(main())
